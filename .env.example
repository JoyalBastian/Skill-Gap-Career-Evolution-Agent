# Copy to .env and adjust (do not commit .env)

SITE_NAME=CareerPath

DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# AI provider: gemini (Google API) or ollama (local, e.g. Docker)
AI_PROVIDER=gemini
# Post-interview analysis provider; set gemini for fast pipeline while keeping interview on ollama
# ANALYSIS_AI_PROVIDER=gemini
# When Gemini fails (quota/503), fall back to local Ollama if AI_PROVIDER=ollama
LLM_GEMINI_FALLBACK_OLLAMA=True

# Docker only: start Ollama containers when AI_PROVIDER=ollama (leave empty for Gemini-only)
# COMPOSE_PROFILES=ollama

# Gemini — required for resume analysis (get key at https://aistudio.google.com/apikey, starts with AIzaSy)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=True
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-flash-latest
# Retries per model on 503/high-demand before switching fallback models
GEMINI_MAX_RETRIES=3

# Ollama (when AI_PROVIDER=ollama)
# Local runserver: http://localhost:11434  |  Docker web: set automatically to http://ollama:11434
# Interview quality needs a 7B+ model: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
OLLAMA_DEFAULT_MAX_TOKENS=2048
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m
# Must be >= longest AI request; matches gunicorn --timeout in Dockerfile
GUNICORN_TIMEOUT=300

# Resume upload: set True to run full pipeline on upload (uses more API calls)
RUN_AI_PIPELINE_ON_RESUME=False

# Live job vacancies (Remotive / Arbeitnow — no API key required)
JOB_API_PROVIDER=remotive
JOB_API_TIMEOUT=10
JOB_VACANCY_CACHE_MINUTES=30
JOB_DEFAULT_REMOTE=True

# SQLite path (relative to backend/); use db/db.sqlite3 in Docker
DATABASE_PATH=db.sqlite3
